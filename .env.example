# pyfortiaigate live tests: copy to .env and fill in. .env is gitignored.
# Variables already set in your shell win over this file.
# The live tests only READ (me, list calls, one page of audit logs).

# Set to 1 to run tests/live once the values below are filled in (skipped otherwise)
FAIG_LIVE=

# Management URL: https://host, a bare host, or https://host/api (e.g. https://faig.example.com)
FAIG_URL=

# Session login: the account's email (the built-in admin is "admin")
FAIG_USERNAME=
FAIG_PASSWORD=

# Or a bearer token instead of a username/password
FAIG_TOKEN=

# TLS: a CA file that signed the appliance's certificate (preferred), or
# FAIG_VERIFY_TLS=false to skip checking (isolated labs / localhost tunnels only)
FAIG_CA_BUNDLE=
FAIG_VERIFY_TLS=

# Write tests (tests/live/test_live_write.py): the workspace they may write in.
# They create pytest-* objects there and delete them afterwards. Blank = skipped.
FAIG_WRITE_WORKSPACE=
# Optional: model for the two gateway chat calls (default: workspace's first OpenAI model)
FAIG_TEST_MODEL=
