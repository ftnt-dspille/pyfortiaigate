# Workshop settings. Copy to your settings file and fill in:
#   mkdir -p ~/.config/pyfortiaigate
#   cp env.example ~/.config/pyfortiaigate/.env && chmod 600 ~/.config/pyfortiaigate/.env
# The scripts here and the pyfortiaigate command both read it.

# Your FortiAIGate: the address from your browser tab (anything after the
# host, such as /ui, is ignored)
FAIG_URL=https://<faig-address>

# The login you use in the FortiAIGate console
FAIG_USERNAME=studentXX@lab.local
FAIG_PASSWORD=<your-password>

# Your workspace (it is named after your student ID)
FAIG_WS=studentXX

# Your virtual key: the API_KEY value in ~/.faig-lab.env
FAIG_KEY=faig_...
# Its name, as you typed it when you created it
FAIG_KEY_NAME=studentXX-key

# The lab FortiAIGate uses a self-signed certificate, so skip TLS checks.
# (On a real deployment, use FAIG_CA_BUNDLE=/path/to/ca.pem instead.)
FAIG_VERIFY_TLS=false
